# Required: copy this file to .env and replace the placeholders.
TAVILY_API_KEY="tvly-..."
NEBIUS_API_KEY="..."

# DealLens deliberately uses Nebius-hosted inference for quote selection and
# grounded memo narratives. Tavily Research remains the discovery worker.
DEALLENS_MODEL="moonshotai/Kimi-K3"

# Recommended for the take-home: create a LangSmith API key, then enable tracing.
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY="lsv2_..."
LANGSMITH_PROJECT="Deal_Lens"
# Use this endpoint when the LangSmith account is hosted in the EU region.
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
